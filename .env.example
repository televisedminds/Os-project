# Opportunity OS — live mode configuration.
# Copy to .env, fill in, then load with:  set -a; source .env; set +a
# (the systemd unit in deploy/ loads it via EnvironmentFile)

OOS_MODE=live
OOS_DB=data/live.db
# OOS_WATCHLIST=watchlist.json
# OOS_PLAN=pro
# OOS_CAPITAL_CAP=2000            # USD you are willing to deploy per opportunity

# --- eBay Browse API (required for the sell-side scanner) -------------------
# Free: developer.ebay.com → Your Account → Application Keys → Production keyset.
# Use the App ID (Client ID) + Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=production             # or "sandbox" while testing

# --- Reddit (recommended: demand signal for niches/products) ----------------
# Free: reddit.com/prefs/apps → create app → type "script".
# Without keys the public JSON endpoint is tried, but datacenter IPs
# (DigitalOcean included) are usually blocked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- ScrapingDog (optional: Shopee prices + competitor evidence) ------------
# scrapingdog.com — paid scraping proxy with free trial credits. Two jobs:
# (1) read Shopee TH search results (price/sold/stock) automatically, and
# (2) read the provider pages Serper finds for a niche and extract competitor
# pricing + review signal — grounding a service's price point in what real
# providers charge instead of an estimate.
# EXPERIMENTAL: scraping can break when a site changes and may conflict with
# platform terms; it degrades to no-evidence, and manual quotes always work.
SCRAPINGDOG_API_KEY=
# OOS_SCRAPE_EVERY=4              # scrape every Nth cycle (saves credits)

# --- Telegram briefing push (optional but great) -----------------------------
# @BotFather → /newbot → token. Then message your bot once and get your chat id:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[0-9]*'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Serper (the non-flip evidence engine) -----------------------------------
# serper.dev — 2,500 free searches at signup, no card. This key powers three
# things now: (1) niche demand series via Google (Thai niches are measured in
# Thai against google.co.th), (2) OBSERVED supply scans — who already serves a
# niche — which ventures need before they can verify (unknown supply = research
# required, never guessed), (3) the TH+EN gap-mining discovery source that
# finds Thailand local-service/B2B/digital candidates. Without it, non-flip
# opportunity types stay research-only.
SERPER_API_KEY=
# OOS_SERPER_EVERY=12              # measurement pass cadence (every Nth cycle)
# OOS_SERPER_NICHE_BUDGET=12       # max credits per measurement pass
# OOS_SERPER_DISCOVERY_BUDGET=6    # max credits per gap-mining sweep

# --- AI brain (recommended: the single biggest quality upgrade) --------------
# Claude judges every discovery sweep: drops noise (news/sports/memes), fixes
# categories, rescores by real commerce potential, and explains each verdict.
# Get a key: console.anthropic.com → API keys (buy ~$5 credit to start).
# Runs once per sweep (~8 calls/day, batched) — typically a few cents per day.
ANTHROPIC_API_KEY=
# OOS_AI_MODEL=claude-opus-4-8   # best judgment (default); or claude-haiku-4-5 = cheaper
# OOS_AI=1                       # 0 = keep the key but turn AI judgment off

# --- Discovery engine --------------------------------------------------------
# Auto-finds NEW products/niches to watch, so live mode is no longer limited to
# your hand-typed watchlist. Sources: Google Trends (keyless), Reddit commerce
# subreddits (uses REDDIT_* above), eBay category sweep (uses EBAY_* above).
# The eBay + Reddit keys are what make discovery actually productive — without
# them only the keyless Google Trends source runs (and it is filtered hard).
OOS_DISCOVERY=1                  # 1 = on (default in live), 0 = off
# OOS_DISCOVER_EVERY=6           # run a discovery sweep every Nth cycle
# OOS_DISCOVERY_MAX=40           # cap how many discovered entities stay watched
# OOS_DISCOVERY_TTL_DAYS=10      # retire a discovery not re-seen in this many days
# OOS_DISCOVERY_GEO=US           # Google Trends region

# Type-diversity budget: split the watched set across opportunity FAMILIES so
# rich-evidence physical flips can't expire every gap-mined Thai niche. Shares
# adapt toward families that verify, but never below an exploration floor, and
# a family's budget only affects how much it's WATCHED — never the publish bar.
OOS_DIVERSITY=1                  # 1 = on (default), 0 = plain top-by-score
# OOS_DIVERSITY_MIN_FLOOR=8      # min watch slots reserved per family
# OOS_DIVERSITY_ADAPT=0.5        # 0 = fixed shares, 1 = fully yield-driven

# Seasonal generator: how far ahead to scan the Thai event calendar (Songkran,
# 11.11/12.12, school terms, ...). OOS_SEASONAL_TODAY pins "today" for
# deterministic replays/tests; leave empty in production.
# OOS_SEASONAL_HORIZON=90
# OOS_SEASONAL_TODAY=
