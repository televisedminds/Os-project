# Opportunity OS — live mode configuration.
# Copy to .env, fill in, then load with:  set -a; source .env; set +a
# (the systemd unit in deploy/ loads it via EnvironmentFile)

OOS_MODE=live
OOS_DB=data/live.db
# OOS_WATCHLIST=watchlist.json
# OOS_PLAN=pro
# OOS_CAPITAL_CAP=2000            # USD you are willing to deploy per opportunity

# --- eBay Browse API (required for the sell-side scanner) -------------------
# Free: developer.ebay.com → Your Account → Application Keys → Production keyset.
# Use the App ID (Client ID) + Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=production             # or "sandbox" while testing

# --- Reddit (recommended: demand signal for niches/products) ----------------
# Free: reddit.com/prefs/apps → create app → type "script".
# Without keys the public JSON endpoint is tried, but datacenter IPs
# (DigitalOcean included) are usually blocked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- ScrapingDog (optional: auto-watch Shopee TH prices) --------------------
# scrapingdog.com — paid scraping proxy with free trial credits. Lets the
# robot read Shopee TH search results (price/sold/stock) automatically.
# EXPERIMENTAL: scraping can break when the site changes and may conflict
# with platform terms; manual watchlist quotes always work without this.
SCRAPINGDOG_API_KEY=
# OOS_SCRAPE_EVERY=4              # scrape every Nth cycle (saves credits)

# --- Telegram briefing push (optional but great) -----------------------------
# @BotFather → /newbot → token. Then message your bot once and get your chat id:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[0-9]*'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI brain (recommended: the single biggest quality upgrade) --------------
# Claude judges every discovery sweep: drops noise (news/sports/memes), fixes
# categories, rescores by real commerce potential, and explains each verdict.
# Get a key: console.anthropic.com → API keys (buy ~$5 credit to start).
# Runs once per sweep (~8 calls/day, batched) — typically a few cents per day.
ANTHROPIC_API_KEY=
# OOS_AI_MODEL=claude-opus-4-8   # best judgment (default); or claude-haiku-4-5 = cheaper
# OOS_AI=1                       # 0 = keep the key but turn AI judgment off

# --- Discovery engine --------------------------------------------------------
# Auto-finds NEW products/niches to watch, so live mode is no longer limited to
# your hand-typed watchlist. Sources: Google Trends (keyless), Reddit commerce
# subreddits (uses REDDIT_* above), eBay category sweep (uses EBAY_* above).
# The eBay + Reddit keys are what make discovery actually productive — without
# them only the keyless Google Trends source runs (and it is filtered hard).
OOS_DISCOVERY=1                  # 1 = on (default in live), 0 = off
# OOS_DISCOVER_EVERY=6           # run a discovery sweep every Nth cycle
# OOS_DISCOVERY_MAX=40           # cap how many discovered entities stay watched
# OOS_DISCOVERY_TTL_DAYS=10      # retire a discovery not re-seen in this many days
# OOS_DISCOVERY_GEO=US           # Google Trends region
